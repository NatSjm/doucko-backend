root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140

# Hexagonal layout puts inbound adapters in `adapter.`in`.web`; `in` is a keyword, so the package needs
# backticks, which ktlint's package-name rule refuses. Exempt only those packages.
[**/adapter/in/**.kt]
ktlint_standard_package-name = disabled

[*.{json,yml,yaml,md,mjs}]
indent_size = 2
