# TEST-ONLY values for the isolated e2e stack (tools/e2e-stack.mjs, project doucko-e2e).
# They are deliberately fake and committed: they protect nothing but a throwaway stack bound to
# 127.0.0.1:18082 whose volumes `down` deletes. Never reuse them for the real stack (.env).
# The child name is a placeholder, not a person (NFR-3).
DOUCKO_DB_PASSWORD=e2e-db-password-not-secret
ADMIN_PASSWORD=e2e-admin-password-not-secret
DOUCKO_CHILD_DISPLAY_NAME=Testovací žák
