# Copy to .env and fill in locally. Never commit .env (NFR-3).
DOUCKO_DB_URL=jdbc:postgresql://localhost:5432/doucko
DOUCKO_DB_USER=doucko
DOUCKO_DB_PASSWORD=change-me
# BCrypt hash of the single admin password (FR admin-access). Generate one locally; never commit the plain password.
DOUCKO_ADMIN_PASSWORD_HASH=
# NFR-2: address every published port binds to. 127.0.0.1 (default) = this laptop only; set the
# laptop's home-LAN address (RFC 1918, e.g. 192.168.1.20) to reach the app from the LAN.
# `npm run stack:up` refuses 0.0.0.0, :: and any public address.
DOUCKO_BIND_ADDRESS=127.0.0.1
