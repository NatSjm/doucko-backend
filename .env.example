# Copy to .env and fill in locally. Never commit .env (NFR-3).
DOUCKO_DB_URL=jdbc:postgresql://localhost:5432/doucko
DOUCKO_DB_USER=doucko
DOUCKO_DB_PASSWORD=change-me
# The single admin password (admin-access, NFR-16): at least 12 characters and at most 72 bytes in
# UTF-8, or the backend refuses to start. Only its BCrypt hash is kept in memory; it is never stored or
# logged. Change it by editing .env and restarting. Never commit .env.
ADMIN_PASSWORD=
# NFR-2: address every published port binds to. 127.0.0.1 (default) = this laptop only; set the
# laptop's home-LAN address (RFC 1918, e.g. 192.168.1.20) to reach the app from the LAN.
# `npm run stack:up` refuses 0.0.0.0, :: and any public address.
DOUCKO_BIND_ADDRESS=127.0.0.1
# The child's display name (child-profile, NFR-3). Read only on the first start against an empty
# database: 1 to 50 characters after trimming, no control characters, or the backend refuses to start.
# Later starts keep the stored name and ignore this value. Never commit .env.
DOUCKO_CHILD_DISPLAY_NAME=
